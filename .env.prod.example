# Variables para la pestaña "Environment" de Dokploy (NO es un fichero que se use en local).
# Dokploy las guarda en un .env junto al docker-compose.yml y el servicio las recibe vía env_file.
# APP_ENV, APP_DEBUG y SERVER_NAME ya los fija docker-compose.yml.

# Genera uno nuevo: php -r 'echo bin2hex(random_bytes(16)), PHP_EOL;'
APP_SECRET=CAMBIAME

DEFAULT_URI=https://api.tudominio.com
TRUSTED_PROXIES=private_ranges

# Host interno de la base de datos Postgres creada en Dokploy (pestaña "Internal Credentials")
DATABASE_URL="postgresql://USUARIO:PASSWORD@HOST_INTERNO:5432/farmapremium?serverVersion=18&charset=utf8"

# Opcional (por defecto true): ejecutar migraciones al arrancar el contenedor
# RUN_MIGRATIONS=true
